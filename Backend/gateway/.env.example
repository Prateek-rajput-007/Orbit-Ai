# API Gateway Environment Configuration Example
# Copy this file to .env and adjust values for your environment

# Gateway Server Port
PORT=5000
port=5000

# Downstream Microservices URLs
AUTH_SERVICE_URL=http://localhost:5001
CHAT_SERVICE_URL=http://localhost:5002
AGENT_SERVICE_URL=http://localhost:5003

# Frontend Application URL (CORS allowed origin)
FRONTEND_URL=http://localhost:5173

# Redis Cache & Session Store (Local or Upstash Cloud)
# Local: redis://localhost:6379
# Upstash: rediss://default:password@your-endpoint.upstash.io:6379
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
